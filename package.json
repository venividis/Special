{
  "name": "intact",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "INTACT — one ERC-721 that is a website, a swap, a social layer, a launchpad and a vault, entirely on chain, and moves intact.",
  "scripts": {
    "compile": "node tools/compile.mjs",
    "ship": "node tools/compile.mjs --ship",
    "facets": "node tools/facets.mjs && node tools/facets.mjs --selftest",
    "selftest": "node tools/selftest.mjs",
    "build": "node tools/build-app.mjs",
    "forge": "node tools/forge.mjs",
    "forge:monolith": "INTACT_IMPL=monolith node tools/forge.mjs",
    "forge:diamond": "INTACT_IMPL=diamond node tools/forge.mjs",
    "gas": "node tools/gas.mjs",
    "gas:selftest": "node tools/gas.mjs --selftest",
    "static-audit": "node tools/static-audit.mjs && node tools/static-audit.mjs --selftest",
    "verify": "node tools/verify.mjs",
    "verify:pool": "node tools/verify-pool.mjs",
    "verify:vault": "node tools/verify-vault.mjs",
    "verify:parley": "node tools/verify-parley.mjs",
    "verify:launch": "node tools/verify-launch.mjs",
    "verify:steward": "node tools/verify-steward.mjs",
    "verify:timelock": "node tools/verify-timelock.mjs",
    "verify:premises": "node tools/verify-premises.mjs",
    "verify:site": "node tools/verify-site.mjs",
    "verify:findings": "node tools/verify-findings.mjs",
    "verify:console": "node tools/verify-console.mjs",
    "verify:gateway": "node tools/verify-gateway.mjs",
    "verify:recover": "node tools/verify-recover.mjs",
    "fuzz": "node tools/fuzz.mjs",
    "agents": "node tools/agents.mjs",
    "invariants": "node tools/invariants-check.mjs",
    "check": "npm run compile && npm run facets && npm run selftest && npm run build && npm run forge:monolith && npm run forge:diamond && npm run gas && npm run gas:selftest && npm run verify && npm run verify:site && npm run static-audit && npm run verify:recover"
  },
  "dependencies": {
    "@ethereumjs/common": "^10.1.2",
    "@ethereumjs/evm": "^10.1.2",
    "@ethereumjs/statemanager": "^10.1.2",
    "@ethereumjs/tx": "^10.1.2",
    "@ethereumjs/util": "^10.1.2",
    "@ethereumjs/vm": "^10.1.2",
    "ethereum-cryptography": "^3.2.0",
    "solc": "0.8.36",
    "terser": "^5.49.0"
  },
  "devDependencies": {
    "hardhat": "^2.29.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.62.1"
  },
  "overrides": {
    "tmp": "0.2.7"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
